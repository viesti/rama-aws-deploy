# Rama supervisor configuration
# Generated by Ansible

supervisor.port.range:
  - {{ supervisor_port_range[0] }}
  - {{ supervisor_port_range[1] }}

local.dir: "{{ rama_local_dir }}"

zookeeper.servers:
{% for host in groups['zookeeper'] | sort %}
  - "{{ hostvars[host]['ansible_host'] }}"
{% endfor %}

conductor.host: "{{ conductor_ip }}"

supervisor.host: "{{ supervisor_host_ip }}"
