[Unit]
Description=Rama Conductor

[Service]
# Conductor requires root due to RocksDB JNI library extraction permissions
User=root
Group=root
WorkingDirectory={{ rama_data_dir }}
ExecStart={{ rama_data_dir }}/rama conductor
Restart=always
RestartSec=3
# We need KillMode in here to make sure we don't kill the worker process when
# supervisor process is dead. We take liberty to enable this option even
# while it *is not recommended* in the docs, since we manage the lifecycle of
# worker processes within supervisor.
# https://www.freedesktop.org/software/systemd/man/systemd.kill.html#KillMode=
KillMode=process

[Install]
WantedBy=default.target
