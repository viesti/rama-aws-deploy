# Local rama.yaml for CLI commands (rama-{{ cluster_name }})
# Generated by Ansible

supervisor.port.range:
  - {{ supervisor_port_range[0] }}
  - {{ supervisor_port_range[1] }}

worker.child.opts: "{{ worker_child_opts }}"

conductor.child.opts: "{{ conductor_child_opts }}"

zookeeper.servers:
{% for host in groups['zookeeper'] | sort %}
  - "{{ hostvars[host]['ansible_host'] }}"
{% endfor %}

conductor.host: "{{ hostvars[groups['conductor'][0]]['ansible_host'] }}"
